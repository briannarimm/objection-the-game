    # Helpers used by phases.rpy and screens.rpy.

    def random_question(exclude=None):
        """Return one question, optionally excluding any whose `q` is in `exclude`."""
        import random as _random
        pool = QUESTIONS
        if exclude:
            pool = [q for q in QUESTIONS if q["q"] not in exclude]
        if not pool:
            pool = QUESTIONS
        return _random.choice(pool)
